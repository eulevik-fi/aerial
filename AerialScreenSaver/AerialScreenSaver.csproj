<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>Aerial</AssemblyName>
    <RootNamespace>Aerial</RootNamespace>
    <!-- Keep the output folder clean -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared sources live in ..\src -->
    <Compile Include="..\src\CaptionsState.cs" Link="src\CaptionsState.cs" />
    <Compile Include="..\src\Downloader.cs" Link="src\Downloader.cs" />
    <Compile Include="..\src\IdleExitTracker.cs" Link="src\IdleExitTracker.cs" />
    <Compile Include="..\src\IVideoCatalog.cs" Link="src\IVideoCatalog.cs" />
    <Compile Include="..\src\KeyHandler.cs" Link="src\KeyHandler.cs" />
    <Compile Include="..\src\LocalizableStrings.cs" Link="src\LocalizableStrings.cs" />
    <Compile Include="..\src\Logging.cs" Link="src\Logging.cs" />
    <Compile Include="..\src\MonitorInfo.cs" Link="src\MonitorInfo.cs" />
    <Compile Include="..\src\MonitorPower.cs" Link="src\MonitorPower.cs" />
    <Compile Include="..\src\RegistryPowerReader.cs" Link="src\RegistryPowerReader.cs" />
    <Compile Include="..\src\ScreenSaverWindow.cs" Link="src\ScreenSaverWindow.cs" />
    <Compile Include="..\src\SrtGeneration.cs" Link="src\SrtGeneration.cs" />
    <Compile Include="..\src\TarExtraction.cs" Link="src\TarExtraction.cs" />
    <Compile Include="..\src\Video.cs" Link="src\Video.cs" />
    <Compile Include="..\src\VideoCatalog_tvOS10.cs" Link="src\VideoCatalog_tvOS10.cs" />
    <Compile Include="..\src\VideoCatalog_tvOS26.cs" Link="src\VideoCatalog_tvOS26.cs" />
    <Compile Include="..\src\VideoController.cs" Link="src\VideoController.cs" />
    <Compile Include="..\src\VideoPlayer.cs" Link="src\VideoPlayer.cs" />
    <Compile Include="..\src\VideoQueue.cs" Link="src\VideoQueue.cs" />

  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.10.1" />
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <PackageReference Include="plist-cil" Version="2.3.1" />
  </ItemGroup>

</Project>
