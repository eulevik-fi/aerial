<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Aerial Screen Saver"
      Manufacturer="Eric Ulevik"
      Version="$(var.ProductVersion)"
      Scope="perMachine"
      UpgradeCode="D6A2D79C-6E5F-4A2A-9AC4-3C50A0EE8DF5">
    <SummaryInformation Description="Aerial Screen Saver" />
    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of Aerial Screen Saver is already installed." />
    <Launch Condition="VersionNT >= 10.0" Message="This product requires Windows 10 build 19045 or later." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AerialIcon" SourceFile="$(var.SourceDir)\Aerial.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Aerial">
        <Directory Id="LIBVLCDIR" Name="libvlc">
          <Directory Id="LIBVLCX64DIR" Name="win-x64" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="PROGRAMMENUAERIALFOLDER" Name="Aerial Screen Saver" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Aerial Screen Saver" Level="1">
      <ComponentRef Id="SetupAerialShortcut" />
      <Files Include="$(var.SourceDir)\**" Directory="INSTALLFOLDER">
        <Exclude Files="$(var.SourceDir)\AerialApp*" />
        <Exclude Files="$(var.SourceDir)\AerialSetup.exe" />
        <Exclude Files="$(var.SourceDir)\AerialInstallerCA.dll" />
        <Exclude Files="$(var.SourceDir)\**\*.pdb" />
      </Files>
    </Feature>

    <Binary Id="AerialInstallerCA" SourceFile="$(var.SourceDir)\AerialInstallerCA.dll" />
    <CustomAction
      Id="FindPreviousPerMachineInstallations"
      BinaryRef="AerialInstallerCA"
      DllEntry="FindPreviousPerMachineInstallations"
      Execute="immediate"
      Return="check" />

    <Component Id="SetupAerialShortcut" Directory="INSTALLFOLDER" Guid="*">
      <File Id="SetupAerialLauncher" Source="$(var.SourceDir)\AerialSetup.exe" KeyPath="yes" />
      <Shortcut
        Id="SetupAerialDesktopShortcut"
        Directory="DesktopFolder"
        Name="Setup Aerial"
        Target="[INSTALLFOLDER]AerialSetup.exe"
        Icon="AerialIcon"
        WorkingDirectory="INSTALLFOLDER" />
      <Shortcut
        Id="SetupAerialStartMenuShortcut"
        Directory="PROGRAMMENUAERIALFOLDER"
        Name="Setup Aerial"
        Target="[INSTALLFOLDER]AerialSetup.exe"
        Icon="AerialIcon"
        WorkingDirectory="INSTALLFOLDER" />
    </Component>
    
    <CustomAction
        Id="RunSetupAerial"
        Directory="SystemFolder"
        ExeCommand="&quot;[INSTALLFOLDER]AerialSetup.exe&quot;"
        Execute="commit"
        Impersonate="yes"
        Return="asyncNoWait" />
    
    <InstallExecuteSequence>
      <Custom Action="RunSetupAerial" Before="InstallFinalize" Condition="NOT REMOVE AND UILevel &gt; 2" />
      <Custom Action="FindPreviousPerMachineInstallations" Before="RemoveExistingProducts" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

  </Package>
</Wix>
