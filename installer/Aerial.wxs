<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Aerial Screen Saver"
      Manufacturer="Eric Ulevik"
      Version="$(var.ProductVersion)"
      Scope="perUser"
      UpgradeCode="D6A2D79C-6E5F-4A2A-9AC4-3C50A0EE8DF5">
    <SummaryInformation Description="Aerial Screen Saver" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Aerial Screen Saver is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="PROGRAMSDIR" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Aerial Screen Saver">
          <Directory Id="LIBVLCDIR" Name="libvlc">
            <Directory Id="LIBVLCX64DIR" Name="win-x64" />
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Aerial Screen Saver" Level="1">
      <ComponentRef Id="ScreenSaverRegistration" />
      <Files Include="$(var.SourceDir)\**" Directory="INSTALLFOLDER" />
    </Feature>

    <Component Id="ScreenSaverRegistration" Directory="INSTALLFOLDER" Guid="*">
      <RegistryValue
        Root="HKCU"
        Key="Control Panel\Desktop"
        Name="SCRNSAVE.EXE"
          Value="[INSTALLFOLDER]Aerial.scr"
          Type="string"
          KeyPath="yes" />
      <RegistryValue
        Root="HKCU"
        Key="Control Panel\Desktop"
        Name="ScreenSaveActive"
        Value="1"
        Type="integer" />
      <RegistryValue
        Root="HKCU"
        Key="Control Panel\Desktop"
        Name="ScreenSaveTimeOut"
        Value="300"
        Type="string" />
    </Component>

     <CustomAction
        Id="UpdateScreenSaverSettings"
        Directory="SystemFolder"
        ExeCommand="powershell.exe -NoLogo -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -Command &quot;$signature = '[System.Runtime.InteropServices.DllImport(''user32.dll'')] public static extern bool SystemParametersInfo(int uAction, int uParam, ref int lpvParam, int fuWinIni);'; $type = Add-Type -MemberDefinition $signature -Name 'Win32Utils' -Namespace 'Win32' -PassThru; $timeout = 300; $type::SystemParametersInfo(15, $timeout, [ref]$timeout, 3) | Out-Null; $active = 1; $type::SystemParametersInfo(17, $active, [ref]$active, 3) | Out-Null&quot;"
        Execute="commit"
        Impersonate="yes"
        Return="ignore" />

    <CustomAction
        Id="OpenControlPanelScreenSaver"
        Directory="SystemFolder"
        ExeCommand="powershell.exe -NoLogo -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -Command &quot;Start-Process -WindowStyle Hidden -FilePath (Join-Path $env:WINDIR 'System32\rundll32.exe') -ArgumentList 'shell32.dll,Control_RunDLL desk.cpl,,1'&quot;"
        Execute="commit"
        Impersonate="yes"
        Return="asyncNoWait" />

   <InstallExecuteSequence>
      <Custom Action="UpdateScreenSaverSettings" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="OpenControlPanelScreenSaver" After="UpdateScreenSaverSettings" Condition="NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
