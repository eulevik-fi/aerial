<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Aerial Screen Saver"
      Manufacturer="Eric Ulevik"
      Version="$(var.ProductVersion)"
      Scope="perUser"
      UpgradeCode="D6A2D79C-6E5F-4A2A-9AC4-3C50A0EE8DF5">
    <SummaryInformation Description="Aerial Screen Saver" />
    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of Aerial Screen Saver is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AerialIcon" SourceFile="$(var.SourceDir)\Aerial.ico" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="PROGRAMSDIR" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Aerial Screen Saver">
          <Directory Id="LIBVLCDIR" Name="libvlc">
            <Directory Id="LIBVLCX64DIR" Name="win-x64" />
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="PROGRAMMENUAERIALFOLDER" Name="Aerial Screen Saver" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Aerial Screen Saver" Level="1">
      <ComponentRef Id="RegisterScreensaverShortcut" />
      <Files Include="$(var.SourceDir)\**" Directory="INSTALLFOLDER">
        <Exclude Files="$(var.SourceDir)\Setup Aerial.vbs" />
      </Files>
    </Feature>

    <Component Id="RegisterScreensaverShortcut" Directory="INSTALLFOLDER" Guid="*">
      <File Id="RegisterScreensaverLauncher" Source="$(var.SourceDir)\Setup Aerial.vbs" />
      <Shortcut
        Id="SetupAerialDesktopShortcut"
        Directory="DesktopFolder"
        Name="Setup Aerial"
        Target="[SystemFolder]wscript.exe"
        Arguments="&quot;[INSTALLFOLDER]Setup Aerial.vbs&quot;"
        Icon="AerialIcon"
        WorkingDirectory="INSTALLFOLDER" />
      <Shortcut
        Id="SetupAerialStartMenuShortcut"
        Directory="PROGRAMMENUAERIALFOLDER"
        Name="Setup Aerial"
        Target="[SystemFolder]wscript.exe"
        Arguments="&quot;[INSTALLFOLDER]Setup Aerial.vbs&quot;"
        Icon="AerialIcon"
        WorkingDirectory="INSTALLFOLDER" />
    </Component>
    
    <CustomAction
        Id="RunSetupAerial"
        Directory="SystemFolder"
        ExeCommand="wscript.exe &quot;[INSTALLFOLDER]Setup Aerial.vbs&quot;"
        Execute="commit"
        Impersonate="yes"
        Return="asyncNoWait" />
    
    <InstallExecuteSequence>
      <Custom Action="RunSetupAerial" Before="InstallFinalize" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

  </Package>
</Wix>
