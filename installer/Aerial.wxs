<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Aerial Screen Saver"
      Manufacturer="Eric Ulevik"
      Version="$(var.ProductVersion)"
      Scope="perUser"
      UpgradeCode="D6A2D79C-6E5F-4A2A-9AC4-3C50A0EE8DF5">
    <SummaryInformation Description="Aerial Screen Saver" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Aerial Screen Saver is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="PROGRAMSDIR" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Aerial Screen Saver">
          <Directory Id="LIBVLCDIR" Name="libvlc">
            <Directory Id="LIBVLCX64DIR" Name="win-x64" />
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Aerial Screen Saver" Level="1">
      <ComponentRef Id="ScreenSaverRegistration" />
      <Files Include="$(var.SourceDir)\Aerial.scr" Directory="INSTALLFOLDER" />
      <Files Include="$(var.SourceDir)\Aerial.dll" Directory="INSTALLFOLDER" />
      <Files Include="$(var.SourceDir)\Aerial.deps.json" Directory="INSTALLFOLDER" />
      <Files Include="$(var.SourceDir)\Aerial.runtimeconfig.json" Directory="INSTALLFOLDER" />
      <Files Include="$(var.SourceDir)\LibVLCSharp.dll" Directory="INSTALLFOLDER" />
      <Files Include="$(var.SourceDir)\LibVLCSharp.WinForms.dll" Directory="INSTALLFOLDER" />
      <Files Include="$(var.SourceDir)\libvlc\win-x64\**" Directory="LIBVLCX64DIR" />
    </Feature>

    <Component Id="ScreenSaverRegistration" Directory="INSTALLFOLDER" Guid="*">
      <RegistryValue
        Root="HKCU"
        Key="Control Panel\Desktop"
        Name="SCRNSAVE.EXE"
          Value="[INSTALLFOLDER]Aerial.scr"
          Type="string"
          KeyPath="yes" />
      <RegistryValue
        Root="HKCU"
        Key="Control Panel\Desktop"
        Name="ScreenSaveActive"
        Value="1"
        Type="integer" />
    </Component>

    <CustomAction
        Id="BroadcastScreenSaverSettings"
        Directory="SystemFolder"
        ExeCommand="-NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$signature = '[DllImport(''user32.dll'')] public static extern bool SystemParametersInfo(int uAction, int uParam, ref int lpvParam, int fuWinIni);'; $type = Add-Type -MemberDefinition $signature -Name 'Win32Utils' -Namespace 'Win32' -PassThru; $active = 1; $type::SystemParametersInfo(17, $active, [ref]$active, 3) | Out-Null&quot;"
        Execute="deferred"
        Impersonate="yes"
        Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="BroadcastScreenSaverSettings" After="InstallFiles" Condition="NOT Installed" />
    </InstallExecuteSequence>
  </Package>
</Wix>
